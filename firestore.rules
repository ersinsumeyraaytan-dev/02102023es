rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // App shared data document
    match /app_data/{docId} {
      allow read, write: if docId is string && docId.size() <= 64;
    }
  }
}
